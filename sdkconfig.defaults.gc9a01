# The ESP32-S3 kit with a GC9A01 1.28" 240x240 round screen and no touch layer.
#
# Layered over the N16R8 module's defaults:
#
#   idf.py -B build-gc9a01 -DIDF_TARGET=esp32s3 -DSDKCONFIG=build-gc9a01/sdkconfig \
#          -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.n16r8;sdkconfig.defaults.gc9a01" build
#
# Pins are in main/board_pins.h, under CONFIG_BUDDY_S3_PANEL_GC9A01.
CONFIG_BUDDY_S3_PANEL_GC9A01=y

# Voice on, unlike every other default build. With no touch, the wake word is the only
# thing on the kit itself that brings the face back from the idle clock: off, a kit
# left alone for three minutes would show the time until the gateway sent it
# something. The audio is opt-in elsewhere because its first bring-up hung a board;
# this kit is not usable without it.
CONFIG_BUDDY_AUDIO=y
CONFIG_BUDDY_VOICE=y

# The clock's time at 40 pt: 48 runs the full width of a 240 px circle (clock_ui.c).
CONFIG_LV_FONT_MONTSERRAT_40=y
