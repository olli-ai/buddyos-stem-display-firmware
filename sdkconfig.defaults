CONFIG_IDF_TARGET="esp32s3"

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# LVGL. RGB565 to match the panel; ARGB8888 sprites are decoded to it on the fly.
CONFIG_LV_COLOR_DEPTH_16=y
# LVGL reserves this as a static pool in .bss whether it uses it or not. The
# simulator measures the peak at 13,320 B for a four-state face, so 64 KB was
# 50 KB of internal SRAM held against nothing. 32 KB keeps ~2.4x headroom for a
# richer design and hands the rest back to the radio stack, which is what the
# memory question is actually about.
CONFIG_LV_MEM_SIZE_KILOBYTES=32
CONFIG_LV_USE_PERF_MONITOR=n
# Rotation and non-uniform scaling of images are what the motion format asks for.
CONFIG_LV_DRAW_TRANSFORM_USE_MATRIX=y

# ESP32-S3-WROOM-1-N8R2: 8 MB quad flash, 2 MB **quad** PSRAM. (The R8 variant is
# octal and takes GPIO 35-37; R2 does not, so the panel pins are clear either way.)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# The knob that decides the answer: Wi-Fi and LWIP buffers go to PSRAM, leaving
# internal SRAM for the things that cannot live anywhere else — DMA descriptors,
# the panel buffers, and the parts of the TLS path that must be internal. Worth
# measuring with this off as well, since that is the pessimistic case.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# mbedTLS allocates from PSRAM rather than internal SRAM. This is the single
# largest lever measured on this board, and it decides whether the voice path fits:
# with a TLS session up to the product broker, the largest contiguous *internal*
# block is 32,768 B without it and 61,440 B with it. The session's ~32 KB simply
# moves to PSRAM, which has 2 MB and nothing else asking for it.
#
# Total free is not what this buys — that barely moves. Contiguity is, and a large
# contiguous internal block is what a DMA buffer or a second TLS context needs.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# 240 MHz and -O2, which were simply never turned on. Measured on the board with the
# lip-sync classifier, the workload here most like Opus: 1,777 us per 16 ms of audio
# at 160 MHz and -Og, 776 us with these two lines. 2.3x for no code and no memory —
# internal free actually went *up*, because -O2 lays the image out differently.
#
# The voice path has to fit alongside the face on this part, so headroom that costs
# nothing should not be left on the table while anyone argues about whether a codec
# fits.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# The WebSocket handshake is built in IDF's transport layer, in a buffer this sizes —
# not the client's buffer_size, which is a different buffer. The voice route takes
# the user token in the query string (a WebSocket handshake carries no Authorization
# header the gateway reads), so the request line alone is over a kilobyte: the
# default 1024 failed with "desired request len: 1209, buffer size: 1024".
CONFIG_WS_BUFFER_SIZE=4096

# Wake word: "Jarvis", detected on the S3 by ESP-SR WakeNet9. No audio leaves the
# device until it hears it. The model is packed into the `model` partition at build.
CONFIG_SR_WN_WN9_JARVIS_TTS=y

# BLE setup: NimBLE, peripheral only — the settings our other STEM kits use.
# One service, one characteristic;
# Bluedroid would cost about twice the flash and RAM to do it.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# The setup app sends a ~2.4 KB credentials message; a larger MTU means fewer chunks.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=4
# The host's allocations to PSRAM, of which this board has 8 MB going spare:
# internal RAM is what TLS and DMA are short of, so move what can be moved.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
